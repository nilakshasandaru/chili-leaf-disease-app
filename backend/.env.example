# Copy this file to .env and fill in real values. Never commit the real .env file.

# MySQL connection
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chili_doctor

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Flask
FLASK_ENV=development
UPLOAD_FOLDER=uploads

# ML models (paths to trained .h5 files)
HEALTH_MODEL_PATH=app/ml/saved_models/health_classifier.h5
DISEASE_MODEL_PATH=app/ml/saved_models/disease_classifier.h5
